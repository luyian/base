/* pages/index/index.wxss - 元灵工具箱首页 */
/* 设计概念：瓷青纸面 + 墨色结构，朱砂只用于点睛（seal） */
page {
  --paper: #F1F3EF;
  --card: #FBFBF8;
  --ink: #22302A;
  --ink-2: #5C6B63;
  --ink-3: #9AA69F;
  --seal: #C6402E;
  --seal-soft: rgba(198, 64, 46, 0.10);
  --gold: #B08D46;
  --hairline: #E1E5DF;
  --shadow: 0 2rpx 6rpx rgba(34, 48, 42, 0.05), 0 10rpx 28rpx rgba(34, 48, 42, 0.06);

  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  min-height: 100vh;
  background: var(--paper);
  padding: 24rpx 40rpx 64rpx;
  box-sizing: border-box;
}

/* ==================== 顶部 Logo 区 ==================== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 48rpx;
  animation: fade-up 0.4s ease both;
}

.hero-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  background: var(--card);
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.hero-logo-img {
  width: 120rpx;
  height: 120rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.hero-seal {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--seal);
  border-radius: 8rpx 12rpx 8rpx 12rpx;
  color: var(--seal);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-8deg);
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

/* ==================== 工具宫格 ==================== */
.grid {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}

.tool-card {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--hairline);
  border-radius: 28rpx;
  padding: 40rpx 28rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.15s ease;
  animation: fade-up 0.4s ease both;
  box-sizing: border-box;
}

.tool-card:nth-child(1) { animation-delay: 0.05s; }
.tool-card:nth-child(2) { animation-delay: 0.1s; }

.tool-card:active {
  transform: scale(0.97);
}

.tool-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--seal-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-bottom: 24rpx;
}

.tool-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.tool-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
}

/* ==================== 底部 ==================== */
.footer {
  margin-top: 80rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

/* ==================== 动效 ==================== */
@keyframes fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .hero,
  .tool-card {
    animation: none !important;
  }
}

/* ==================== Dark Theme ==================== */
.dark-theme,
.dark-theme page {
  --paper: #131A16;
  --card: #1B231F;
  --ink: #E9EDE9;
  --ink-2: #A7B2AB;
  --ink-3: #6C7871;
  --seal: #E25A45;
  --seal-soft: rgba(226, 90, 69, 0.16);
  --gold: #C6A25C;
  --hairline: #2A342E;
  --shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3), 0 10rpx 28rpx rgba(0, 0, 0, 0.25);

  background: var(--paper);
  color: var(--ink);
}