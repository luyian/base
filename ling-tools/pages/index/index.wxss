/* pages/index/index.wxss - 元灵工具箱首页（手机桌面式） */
/* 设计概念：瓷青纸面 + 墨色结构，朱砂只用于点睛（seal） */
page {
  --paper: #F1F3EF;
  --card: #FBFBF8;
  --ink: #22302A;
  --ink-2: #5C6B63;
  --ink-3: #9AA69F;
  --seal: #C6402E;
  --seal-soft: rgba(198, 64, 46, 0.10);
  --gold: #B08D46;
  --hairline: #E1E5DF;
  --shadow: 0 2rpx 6rpx rgba(34, 48, 42, 0.05), 0 10rpx 28rpx rgba(34, 48, 42, 0.06);

  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  height: 100vh;
  background: var(--paper);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 桌面滚动区：占满导航栏以下剩余高度，可上下滑动 */
.desktop {
  flex: 1;
  min-height: 0;
  padding: 24rpx 40rpx 96rpx;
  box-sizing: border-box;
}

/* ==================== 顶部 Logo 区 ==================== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
  animation: fade-up 0.4s ease both;
}

.hero-logo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 34rpx;
  background: var(--card);
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
}

.hero-logo-img {
  width: 112rpx;
  height: 112rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.hero-seal {
  width: 46rpx;
  height: 46rpx;
  border: 4rpx solid var(--seal);
  border-radius: 8rpx 12rpx 8rpx 12rpx;
  color: var(--seal);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-8deg);
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

/* ==================== 桌面应用网格 ==================== */
.desktop-label {
  font-size: 26rpx;
  color: var(--ink-3);
  letter-spacing: 4rpx;
  margin: 12rpx 8rpx 20rpx;
}

.app-grid {
  display: flex;
  gap: 28rpx;
  flex-wrap: wrap;
}

/* 桌面 app 图标：圆角色块 + 名称，纵向排列，可下拉/上滑 */
.app-icon {
  width: calc((100% - 56rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fade-up 0.4s ease both;
}
.app-icon:nth-child(1) { animation-delay: 0.05s; }
.app-icon:nth-child(2) { animation-delay: 0.1s; }
.app-icon:nth-child(3) { animation-delay: 0.15s; }

.app-icon:active .app-glyph {
  transform: scale(0.94);
}

.app-glyph {
  width: 116rpx;
  height: 116rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  box-shadow: var(--shadow);
  transition: transform 0.15s ease;
}
.app-glyph.se {
  background: linear-gradient(145deg, #E25A45, #C6402E);
}
.app-glyph.go {
  background: linear-gradient(145deg, #C6A25C, #B08D46);
}
.app-glyph.bl {
  background: linear-gradient(145deg, #7093B0, #4E6E8E);
}

.app-name {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}
.app-icon:active .app-name {
  color: var(--seal);
}

/* ==================== 底部 ==================== */
.footer {
  margin-top: 96rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

/* ==================== 动效 ==================== */
@keyframes fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .hero,
  .app-icon {
    animation: none !important;
  }
}

/* ==================== Dark Theme ==================== */
.dark-theme,
.dark-theme page {
  --paper: #131A16;
  --card: #1B231F;
  --ink: #E9EDE9;
  --ink-2: #A7B2AB;
  --ink-3: #6C7871;
  --seal: #E25A45;
  --seal-soft: rgba(226, 90, 69, 0.16);
  --gold: #C6A25C;
  --hairline: #2A342E;
  --shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3), 0 10rpx 28rpx rgba(0, 0, 0, 0.25);

  background: var(--paper);
  color: var(--ink);
}