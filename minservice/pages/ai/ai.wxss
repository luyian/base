/* pages/ai/ai.wxss - AI 助手页面样式 */
page {
  --primary: #3B82F6;
  --primary-light: #EFF6FF;
  --bg: #F5F7FA;
  --card: #FFFFFF;
  --text-primary: #1E293B;
  --text-secondary: #64748B;
  --text-tertiary: #94A3B8;
  --border: #E2E8F0;
  --shadow: 0 1px 3px rgba(0, 0, 0, 0.04);

  background: var(--bg);
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* 模式切换栏 */
.mode-bar {
  display: flex;
  justify-content: center;
  padding: 16rpx 32rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--border);
}

.mode-switch {
  display: flex;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 6rpx;
  gap: 4rpx;
}

.mode-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  transition: all 0.25s ease;
}

.mode-btn.active {
  background: var(--card);
  color: var(--primary);
  font-weight: 500;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}

.mode-icon {
  font-size: 28rpx;
}

/* 聊天区域 */
.chat-area {
  flex: 1;
  padding: 24rpx 24rpx 0;
  overflow-y: auto;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

/* 快捷问题 */
.quick-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quick-item {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  transition: all 0.2s;
}

.quick-item:active {
  background: var(--primary-light);
  border-color: var(--primary);
  transform: scale(0.98);
}

/* 消息列表 */
.msg-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.msg-avatar.ai {
  background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
}

.msg-avatar.user {
  background: linear-gradient(135deg, #F0FDF4, #DCFCE7);
}

.msg-avatar-img {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.msg-avatar.user .msg-avatar-img {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

/* 消息气泡 */
.msg-bubble {
  max-width: 75%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.msg-bubble.assistant {
  background: var(--card);
  color: var(--text-primary);
  border-top-left-radius: 6rpx;
  box-shadow: var(--shadow);
}

.msg-bubble.user {
  background: var(--primary);
  color: #FFFFFF;
  border-top-right-radius: 6rpx;
}

.msg-text {
  white-space: pre-wrap;
}

/* 打字动画 */
.typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  animation: bounce 1.4s infinite ease-in-out;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* 底部占位 */
.bottom-spacer {
  height: 32rpx;
}

/* 输入栏 */
.input-bar {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--border);
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg);
  border-radius: 40rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  border: 1rpx solid var(--border);
  transition: border-color 0.2s;
}

.input-wrap:focus-within {
  border-color: var(--primary);
}

.msg-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.input-placeholder {
  color: var(--text-tertiary);
}

.send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  flex-shrink: 0;
}

.send-btn.active {
  background: var(--primary);
}

.send-btn:active {
  transform: scale(0.92);
}

.send-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  transform: rotate(-45deg);
}
