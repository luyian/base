<!--pages/index/index.wxml - 元灵工具箱首页（手机桌面式工具宫格）-->
<view class="container {{themeClass}}">
  <nav-bar title="元灵工具箱" />

  <scroll-view class="desktop" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 桌面应用区：PDF 工具图标（点击进入文件转换对应 tab） -->
    <view class="desktop-label">文件工具</view>
    <view class="app-grid">
      <view class="app-icon" bindtap="goToFileTab" data-tab="compress">
        <view class="app-glyph"><text class="glyph-text">🗜️</text></view>
        <text class="app-name">PDF 压缩</text>
      </view>
      <view class="app-icon" bindtap="goToFileTab" data-tab="arrange">
        <view class="app-glyph"><text class="glyph-text">🗂️</text></view>
        <text class="app-name">PDF 整理</text>
      </view>
      <view class="app-icon" bindtap="goToFileTab" data-tab="convert">
        <view class="app-glyph"><text class="glyph-text">🔄</text></view>
        <text class="app-name">PDF 转换</text>
      </view>
    </view>

    <!-- 图片工具区 -->
    <view class="desktop-label">图片工具</view>
    <view class="app-grid">
      <view class="app-icon" bindtap="goToFileTab" data-tab="watermark">
        <view class="app-glyph"><text class="glyph-text">✨</text></view>
        <text class="app-name">去水印</text>
      </view>
    </view>

    <!-- 商品条码区 -->
    <view class="desktop-label">条码工具</view>
    <view class="app-grid">
      <view class="app-icon" bindtap="goToBarcode">
        <view class="app-glyph"><text class="glyph-text">📦</text></view>
        <text class="app-name">条码/二维码</text>
      </view>
    </view>

    <!-- 底部版本 -->
    <view class="footer">
      <text class="footer-text">元灵工具箱 · v1.0</text>
    </view>
  </scroll-view>
</view>