<!--pages/checkin/checkin.wxml-->
<view class="container {{themeClass}}">
  <nav-bar title="打卡" />

  <!-- 月历区 -->
  <view class="calendar-card">
    <view class="cal-head">
      <view class="cal-title">
        <text class="cal-month-num num">{{displayMonth}}</text>
        <view class="cal-ym">
          <text class="cal-year num">{{displayYear}}</text>
          <text class="cal-sub">月 · 打卡日历</text>
        </view>
      </view>
      <view class="cal-switch">
        <view class="switch-btn" bindtap="onPrevMonth">
          <text class="switch-icon">‹</text>
        </view>
        <view class="switch-btn" bindtap="onNextMonth">
          <text class="switch-icon">›</text>
        </view>
      </view>
    </view>

    <view class="week-row">
      <text class="week-cell" wx:for="{{weekDays}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="day-grid">
      <view wx:for="{{calendarCells}}" wx:key="key"
            class="day-cell {{item.inMonth ? '' : 'day-empty'}} {{item.isToday ? 'day-today' : ''}} {{item.date === selectedDate ? 'day-selected' : ''}}"
            data-date="{{item.date}}"
            bindtap="onTapDay"
            bindlongpress="onLongPressDay">
        <block wx:if="{{item.inMonth}}">
          <view class="day-num-wrap {{item.ratio >= 1 ? 'ratio-full' : (item.ratio > 0 ? 'ratio-partial' : '')}}">
            <text class="day-num num">{{item.day}}</text>
          </view>
          <text class="day-progress num" wx:if="{{item.total > 0}}">{{item.completed}}/{{item.total}}</text>
        </block>
      </view>
    </view>
  </view>

  <!-- 计划区标题 -->
  <view class="section-header" bindtap="onTapTitle">
    <text class="section-title">{{selectedDate ? selectedDate + ' 计划' : '今日计划'}}</text>
    <text class="section-date num {{selectedDate ? 'date-back' : ''}}">{{selectedDate ? '返回今日' : today}}</text>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-area">
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{planList.length === 0}}" class="empty-area">
    <view class="empty-stamp"><text>空</text></view>
    <text class="empty-text">还没有计划，先添加一项吧</text>
  </view>

  <!-- 计划列表 -->
  <view wx:else class="plan-list">
    <view wx:for="{{planList}}" wx:key="id"
          class="plan-row {{item.todayChecked ? 'plan-checked' : ''}} {{item.deleted ? 'plan-deleted' : ''}}"
          style="--plan-color: {{item.color || '#C6402E'}}"
          bindtap="onTogglePlan"
          bindlongpress="onLongPressPlan"
          data-id="{{item.id}}">
      <view class="plan-icon-well">
        <text class="plan-icon">{{item.icon || '✔️'}}</text>
      </view>
      <view class="plan-info">
        <view class="plan-title-row">
          <text class="plan-title">{{item.title}}</text>
          <text wx:if="{{item.deleted}}" class="plan-deleted-tag">已删除</text>
        </view>
        <text class="plan-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
      </view>
      <view class="stamp-slot">
        <view wx:if="{{item.todayChecked}}" class="stamp">
          <text>已完成</text>
        </view>
        <view wx:else class="stamp-empty">
          <text>打卡</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 新增按钮 -->
  <view class="add-btn" bindtap="onAddPlan">
    <view class="add-dot"></view>
    <text class="add-text">新增计划</text>
  </view>

  <!-- 新增/编辑弹窗 -->
  <view wx:if="{{showModal}}" class="modal-mask" bindtap="onCloseModal">
    <view class="modal" catchtap="preventBubble">
      <view class="modal-title">{{isEdit ? '编辑计划' : '新增计划'}}</view>

      <view wx:if="{{form.targetDate}}" class="form-item">
        <text class="form-label">日期</text>
        <view class="form-date-display num">{{form.targetDate}}</view>
      </view>

      <view class="form-item">
        <text class="form-label">名称</text>
        <input class="form-input" placeholder="如：背单词、运动" value="{{form.title}}" bindinput="onInputTitle" maxlength="50" />
      </view>

      <view class="form-item">
        <text class="form-label">图标</text>
        <input class="form-input" placeholder="填一个 emoji，如 📚" value="{{form.icon}}" bindinput="onInputIcon" maxlength="4" />
      </view>

      <view class="form-item">
        <text class="form-label">颜色</text>
        <view class="color-row">
          <view wx:for="{{colorOptions}}" wx:key="*this"
                class="color-dot {{form.color === item ? 'color-active' : ''}}"
                style="background: {{item}}"
                data-color="{{item}}"
                bindtap="onChooseColor"></view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="可选" value="{{form.remark}}" bindinput="onInputRemark" maxlength="200" />
      </view>

      <view class="modal-actions">
        <view class="btn btn-cancel" bindtap="onCloseModal">取消</view>
        <view class="btn btn-confirm" bindtap="onSubmitPlan">{{isEdit ? '保存' : '添加'}}</view>
      </view>
    </view>
  </view>
</view>
