/* pages/barcode/barcode.wxss - 商品管理（元灵工具箱） */
/* 视觉：瓷青纸面 + 墨色结构，朱砂用于「扫码」「保存」与主操作 */
page {
  --paper: #F3F2EC;
  --card: #FCFBF6;
  --ink: #2C2E25;
  --ink-2: #6B6E62;
  --ink-3: #A5A79B;
  --seal: #C6402E;
  --seal-deep: #A8301F;
  --seal-soft: rgba(198, 64, 46, 0.10);
  --gold: #B08D46;
  --hairline: #E4E2D6;
  --shadow: 0 2rpx 6rpx rgba(44, 46, 37, 0.05), 0 12rpx 34rpx rgba(44, 46, 37, 0.08);

  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  min-height: 100vh;
  background: var(--paper);
  box-sizing: border-box;
}

.page-body {
  padding: 32rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ==================== 主操作区 ==================== */
.hero-card {
  margin-top: 32rpx;
  padding: 56rpx 44rpx 48rpx;
  background: var(--card);
  border-radius: 32rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fade-up 0.42s ease both;
}

.hero-badge {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: var(--gold);
  border: 1rpx solid var(--hairline);
  border-radius: 999rpx;
}

.hero-title {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
  text-align: center;
}

.scan-btn {
  margin-top: 44rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, var(--seal), var(--seal-deep));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 18rpx 36rpx rgba(198, 64, 46, 0.30),
    0 4rpx 12rpx rgba(198, 64, 46, 0.16),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.25),
    inset 0 -3rpx 8rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.1s ease;
}

.scan-btn-hover {
  transform: scale(0.96);
  opacity: 0.94;
}

.scan-glyph {
  font-size: 72rpx;
  line-height: 1;
  color: #fff;
}

.scan-hint {
  margin-top: 12rpx;
  font-size: 30rpx;
  letter-spacing: 8rpx;
  color: #fff;
  font-weight: 600;
}

.hero-tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 添加商品按钮（主扫码下横排副入口） */
.hero-add {
  margin-top: 32rpx;
  height: 88rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--seal);
  background: var(--seal-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: transform 0.1s ease;
}

.hero-add-icon {
  font-size: 34rpx;
  line-height: 1;
  color: var(--seal);
}

.hero-add-text {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--seal-deep);
}

/* ==================== 商品列表 ==================== */
.list-card {
  margin-top: 32rpx;
  background: var(--card);
  border-radius: 32rpx;
  box-shadow: var(--shadow);
  padding: 36rpx 40rpx 28rpx;
  animation: fade-up 0.42s ease both;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.list-count {
  font-size: 24rpx;
  color: var(--ink-3);
}

.product-list {
  margin-top: 8rpx;
}

.product-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.product-item:last-child {
  border-bottom: none;
}

.product-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.product-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.meta-code {
  font-size: 24rpx;
  color: var(--gold);
  font-family: monospace;
}

.meta-cat {
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 4rpx 14rpx;
  background: var(--seal-soft);
  border-radius: 999rpx;
}

.product-sub {
  font-size: 24rpx;
  color: var(--ink-2);
}

.product-actions {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mini-btn {
  height: 56rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.1s ease;
}

.mini-edit {
  color: var(--ink-2);
  border: 1rpx solid var(--hairline);
}

.mini-bind {
  color: var(--seal);
  border: 1rpx solid var(--seal);
}

.mini-del {
  color: var(--ink-3);
}

.list-more,
.list-end {
  padding: 20rpx 0 4rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

.empty-card {
  margin-top: 32rpx;
  padding: 72rpx 40rpx;
  background: var(--card);
  border-radius: 32rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.empty-icon {
  font-size: 72rpx;
  line-height: 1;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
}

/* ==================== 添加/编辑表单弹层 ==================== */
.form-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 14, 0.55);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}

.form-sheet {
  width: 100%;
  background: var(--card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  animation: slide-up 0.3s ease both;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.form-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.form-close {
  font-size: 44rpx;
  color: var(--ink-3);
  line-height: 1;
  padding: 0 8rpx;
}

.scan-code-chip {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 22rpx;
  background: var(--seal-soft);
  border-radius: 999rpx;
}

.chip-label {
  font-size: 24rpx;
  color: var(--ink-2);
}

.chip-code {
  font-size: 26rpx;
  color: var(--seal-deep);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-scroll {
  flex: 1;
  max-height: 52vh;
  margin-top: 4rpx;
}

.form-readonly,
.form-readonly-empty {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.5;
}

.form-readonly {
  color: var(--ink);
}

.form-readonly-empty {
  color: var(--ink-3);
}

@keyframes slide-up {
  from { transform: translateY(48rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* ==================== 结果 + 编辑表单 ==================== */
.result-card {
  margin-top: 32rpx;
  background: var(--card);
  border-radius: 32rpx;
  box-shadow: var(--shadow);
  padding: 36rpx 40rpx 44rpx;
  animation: fade-up 0.42s ease both;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.result-brand {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--seal);
}

.code-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 16rpx;
  background: var(--seal-soft);
  border-radius: 999rpx;
  max-width: 60%;
}

.code-text {
  font-size: 24rpx;
  color: var(--seal-deep);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-close {
  font-size: 30rpx;
  color: var(--ink-3);
  line-height: 1;
  padding: 0 4rpx;
}

/* 表单 */
.form-list {
  margin-top: 12rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.form-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--ink-2);
}

.form-input {
  flex: 1;
  font-size: 29rpx;
  color: var(--ink);
  line-height: 1.5;
  min-height: 40rpx;
}

.form-half {
  width: 50%;
  box-sizing: border-box;
}

.picker-fake {
  display: flex;
  align-items: center;
}

.picker-placeholder {
  color: var(--ink-3);
}

.form-textarea {
  padding: 20rpx 0;
  height: auto;
}

/* 保存 */
.save-btn {
  margin-top: 36rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(160deg, var(--seal), var(--seal-deep));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 26rpx rgba(198, 64, 46, 0.28);
  transition: transform 0.1s ease;
}

.save-btn-hover {
  transform: scale(0.98);
  opacity: 0.95;
}

.save-btn-disabled {
  opacity: 0.6;
  box-shadow: none;
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==================== 深色主题 ==================== */
.dark-theme,
.dark-theme page {
  --paper: #13170F;
  --card: #1C2117;
  --ink: #E9ECE2;
  --ink-2: #A7AC9C;
  --ink-3: #6C7266;
  --seal: #E25A45;
  --seal-deep: #C83F2C;
  --seal-soft: rgba(226, 90, 69, 0.14);
  --gold: #C9A55C;
  --hairline: #2E3629;
  --shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.30), 0 12rpx 34rpx rgba(0, 0, 0, 0.40);
}