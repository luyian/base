<!--pages/pdfarrange/pdfarrange.wxml - PDF 整理（扫描图片工作区，独立页面）-->
<wxs src="../../common/fmt.wxs" module="fmt" />
<view class="container {{themeClass}}">
  <nav-bar title="PDF 整理" back />

  <view class="panel">
    <!-- 未开始整理 -->
    <block wx:if="{{!workDoc}}">
      <view class="panel-title-row">
        <text class="panel-title">新建整理</text>
      </view>
      <view class="field">
        <text class="field-label">文档命名</text>
        <input class="field-input" placeholder="如：报销单合集" value="{{arrangeName}}" bindinput="onArrangeNameInput" maxlength="50" />
      </view>
      <view class="field">
        <text class="field-label">压缩档位</text>
        <view class="format-row">
          <view class="format-chip {{arrangeLevel === 'high' ? 'active' : ''}}" bindtap="setArrangeLevel" data-lv="high">清晰</view>
          <view class="format-chip {{arrangeLevel === 'standard' ? 'active' : ''}}" bindtap="setArrangeLevel" data-lv="standard">常规</view>
          <view class="format-chip {{arrangeLevel === 'compact' ? 'active' : ''}}" bindtap="setArrangeLevel" data-lv="compact">压缩</view>
        </view>
      </view>
      <button class="primary-btn" bindtap="startArrange" loading="{{creatingWork}}">
        {{creatingWork ? '创建中...' : '开始整理'}}
      </button>
    </block>

    <!-- 工作区 -->
    <block wx:else>
      <view class="work-head">
        <view class="work-info">
          <text class="work-no num">{{workDoc.docNo}}</text>
          <text class="work-name">{{workDoc.docName}}</text>
        </view>
        <text class="work-count">{{workImages.length}} 张图片</text>
      </view>

      <!-- 追加图片区 -->
      <view class="append-row">
        <view class="append-btn" bindtap="chooseArrangeImages">
          <text>＋ 添加图片</text>
        </view>
        <view class="append-btn dark" bindtap="cameraArrange" wx:if="{{planChecked}}">
          <text>📷 拍照</text>
        </view>
      </view>

      <!-- 图片列表（可排序） -->
      <view wx:if="{{workImages.length > 0}}" class="img-list">
        <view wx:for="{{workImages}}" wx:key="_k" class="img-row">
          <image class="img-thumb" src="{{item.localPath}}" mode="aspectFill" />
          <view class="img-actions">
            <view class="img-act {{index === 0 ? 'disabled' : ''}}" bindtap="arrangeMove" data-mode="up" data-index="{{index}}">↑</view>
            <view class="img-act {{index === workImages.length - 1 ? 'disabled' : ''}}" bindtap="arrangeMove" data-mode="down" data-index="{{index}}">↓</view>
            <view class="img-act danger" bindtap="arrangeRemove" data-id="{{item.id}}" data-index="{{index}}">✕</view>
          </view>
        </view>
      </view>

      <!-- 操作栏 -->
      <view class="action-bar">
        <button class="primary-btn" bindtap="finalizeArrange" disabled="{{workImages.length === 0}}" loading="{{finalizingWork}}">
          {{finalizingWork ? '生成中...' : '完成并生成 PDF'}}
        </button>
        <button class="ghost-btn" bindtap="abortArrange">放弃</button>
      </view>

      <!-- 完成结果 -->
      <view wx:if="{{arrangeResult}}" class="result-card">
        <view class="result-row"><text class="label">PDF 文件</text><text class="value">{{arrangeResult.fileName}}</text></view>
        <view class="result-row"><text class="label">大小</text><text class="value">{{fmt.formatSize(arrangeResult.fileSize)}}</text></view>
        <view class="result-row"><text class="label">图片数</text><text class="value">{{arrangeResult.count}} 张</text></view>
        <view class="result-row"><text class="label">状态</text><text class="value">已生成，源图已清理</text></view>
        <view class="result-actions">
          <button class="minor-btn" bindtap="previewResult" data-url="{{arrangeResult.fileUrl}}" data-name="{{arrangeResult.fileName}}" data-type="arrange">预览</button>
          <button class="minor-btn primary-minor" bindtap="saveResult" data-url="{{arrangeResult.fileUrl}}" data-name="{{arrangeResult.fileName}}">保存</button>
        </view>
      </view>
    </block>
  </view>
</view>
