<!--pages/profile/profile.wxml - 我的（用户信息/主题/退出登录）-->
<view class="container {{themeClass}}">
  <nav-bar title="我的" />

  <!-- 用户卡片 -->
  <view class="user-card">
    <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
    <view wx:else class="avatar-seal"><text>{{userInitial}}</text></view>
    <view class="user-meta">
      <text class="user-name">{{displayName}}</text>
      <text class="user-sub">{{displaySub}}</text>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="settings">
    <view class="setting-group">
      <view class="setting-row" bindtap="onToggleTheme">
        <view class="setting-left">
          <text class="setting-icon">🌓</text>
          <text class="setting-label">深色模式</text>
        </view>
        <view class="theme-switch {{themeClass === 'dark-theme' ? 'on' : ''}}">
          <view class="theme-knob"></view>
        </view>
      </view>
      <view class="setting-row" bindtap="onToggleWechat">
        <view class="setting-left">
          <text class="setting-icon">💬</text>
          <text class="setting-label">微信</text>
        </view>
        <text class="setting-value {{wechatBound ? '' : 'value-unbound'}}">{{wechatBound ? '已绑定' : '未绑定，点击绑定'}}</text>
      </view>
      <view class="setting-row">
        <view class="setting-left">
          <text class="setting-icon">⚙️</text>
          <text class="setting-label">关于</text>
        </view>
        <text class="setting-value">元灵工具箱 v1.0</text>
      </view>
    </view>
  </view>

  <button class="logout-btn" bindtap="onLogout">退出登录</button>

  <view class="footer">
    <text class="footer-text">元灵工具箱 · 效率工具集</text>
  </view>
</view>