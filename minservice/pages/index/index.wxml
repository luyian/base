<!--pages/index/index.wxml-->
<view class="container {{themeClass}}">
  <nav-bar title="简基" />
  <!-- Header -->
  <view class="header">
    <view class="header-left">
      <text class="header-title">基金估值</text>
      <text class="header-subtitle">实时更新</text>
    </view>
    <view class="header-right">
      <view class="ai-entry" bindtap="goToAi">
        <image class="ai-entry-img" src="/assets/robot.png" mode="aspectFit" />
        <text class="ai-entry-text">AI 助手</text>
      </view>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-area">
    <view class="loading"></view>
    <text>加载中...</text>
  </view>

  <scroll-view wx:else scroll-y class="fund-list">
    <!-- Watchlist Section -->
    <view class="section-title" wx:if="{{watchlist.length > 0}}">
      <text>我的自选</text>
      <text class="more" bindtap="goToWatchlist">查看全部 ></text>
    </view>

    <view class="watchlist" wx:if="{{watchlist.length > 0}}">
      <view class="fund-card watchlist-card {{topActiveId === item.fundId ? 'top-active' : ''}}"
            wx:for="{{watchlist}}"
            wx:key="id"
            bindtap="goToDetail"
            bindlongpress="onWatchlistLongPress"
            data-id="{{item.fundId}}">
        <view class="fund-info">
          <text class="fund-name">{{item.fundName}}</text>
          <text class="fund-code">{{item.fundCode}}</text>
        </view>
        <view class="fund-change {{item.estimatedChangePercent > 0 ? 'positive' : (item.estimatedChangePercent < 0 ? 'negative' : '')}}">
          <text class="change-value">{{item.estimatedChangePercent > 0 ? '+' : ''}}{{item.estimatedChangePercent}}%</text>
        </view>
        <!-- 长按弹出的气泡操作菜单（浮于卡片上方） -->
        <view wx:if="{{topActiveId === item.fundId}}" class="action-popover">
          <view class="action-item" catchtap="onTopFund" data-id="{{item.fundId}}">
            <text class="action-icon">↑</text>
            <text class="action-label">置顶</text>
          </view>
          <view class="action-divider"></view>
          <view class="action-item action-item-danger" catchtap="onRemoveFund" data-id="{{item.fundId}}" data-name="{{item.fundName}}">
            <text class="action-icon">🗑</text>
            <text class="action-label">删除</text>
          </view>
          <view class="action-arrow"></view>
        </view>
      </view>
    </view>

    <!-- 置顶操作蒙层（点击空白关闭浮层） -->
    <view wx:if="{{topActiveId}}" class="top-mask" catchtap="closeTopMenu"></view>


    <!-- All Funds Section -->
    <view class="section-title">
      <text>今日估值</text>
      <text class="update-time">更新: {{lastUpdate}}</text>
    </view>

    <view class="fund-card" 
          wx:for="{{funds}}" 
          wx:key="id" 
          bindtap="goToDetail" 
          data-id="{{item.fundId}}">
      <view class="fund-info">
        <view class="fund-name-row">
          <text class="fund-name">{{item.fundName}}</text>
          <text class="star" wx:if="{{item.inWatchlist}}">★</text>
        </view>
        <text class="fund-code">{{item.fundCode}}</text>
      </view>
      <view class="fund-change {{item.estimatedChangePercent > 0 ? 'positive' : (item.estimatedChangePercent < 0 ? 'negative' : '')}}">
        <text class="change-value">{{item.estimatedChangePercent > 0 ? '+' : ''}}{{item.estimatedChangePercent}}%</text>
      </view>
    </view>

    <view wx:if="{{funds.length === 0}}" class="empty">
      <text>暂无基金数据</text>
    </view>
  </scroll-view>

  <!-- Refresh button -->
  <view class="refresh-btn" bindtap="refreshData">
    <text class="refresh-icon {{refreshing ? 'spinning' : ''}}">↻</text>
    <text>刷新估值</text>
  </view>
</view>