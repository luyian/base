<!--pages/index/index.wxml - 元灵工具箱首页（工具宫格入口）-->
<view class="container {{themeClass}}">
  <nav-bar title="元灵工具箱" />

  <!-- 顶部 Logo 区：元灵 + 朱砂方章 -->
  <view class="hero">
    <view class="hero-logo">
      <image class="hero-logo-img" src="/assets/logo.png" mode="aspectFit" />
    </view>
    <view class="hero-title-row">
      <text class="hero-title">元灵工具箱</text>
      <view class="hero-seal"><text>灵</text></view>
    </view>
    <text class="hero-sub">文件转换 · 打卡 · 效率工具</text>
  </view>

  <!-- 工具宫格 -->
  <view class="grid">
    <view class="tool-card" bindtap="goToFileConvert">
      <view class="tool-icon">⚙️</view>
      <text class="tool-name">文件转换</text>
      <text class="tool-desc">压缩 · 整理 · 转格式</text>
    </view>
    <view class="tool-card" bindtap="goToCheckin">
      <view class="tool-icon">✅</view>
      <text class="tool-name">打卡</text>
      <text class="tool-desc">习惯 · 计划 · 日历</text>
    </view>
  </view>

  <!-- 底部版本 -->
  <view class="footer">
    <text class="footer-text">元灵工具箱 · v1.0</text>
  </view>
</view>